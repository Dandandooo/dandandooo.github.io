---
import PageShell from "@/layouts/PageShell.astro";
---

<PageShell
  theme="swimming"
  title="Daniel's Swimming"
  description="Daniel Philipov's swimming — training, racing, and progress in the pool."
  kicker="Training, racing, and progress in the pool"
  heading="Swimming"
>
  <section class="coming-soon" aria-label="Coming soon">
    <span class="lane-emoji" aria-hidden="true">🏊</span>
    <p>Times, meets, and progress are on their way. Check back soon.</p>
  </section>
</PageShell>

<style>
  .coming-soon {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    padding: 3.5rem 1rem 4rem;
    border: 1px dashed var(--hairline-strong);
    border-radius: 8px;
    background: rgba(125, 211, 252, 0.05);
    text-align: center;
    opacity: 0;
    animation: rise-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
  }

  .lane-emoji {
    font-size: 2rem;
  }

  .coming-soon p {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--page-accent) 65%, #e2e8f0);
  }
</style>
