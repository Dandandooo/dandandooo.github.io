---
import PageShell from "@/layouts/PageShell.astro";

import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import photo from "@/assets/images/rh_rooftop.jpeg";

// https://icon-sets.iconify.design/catppuccin/page-2.html
const tech_stack: string[] = [
	"catppuccin:python",
	"catppuccin:zig",
	"catppuccin:rust-alt",
	"catppuccin:c",
	"catppuccin:cpp",
	"catppuccin:cuda",
	"catppuccin:javascript-react",
	"catppuccin:javascript",
	"catppuccin:typescript",
	"catppuccin:astro",
	"catppuccin:java",
	"catppuccin:ocaml",
	"catppuccin:lua",
	"catppuccin:latex",
	"catppuccin:docker",
	"catppuccin:git",
	"catppuccin:godot",
	"catppuccin:unity",
	"catppuccin:nix",
	"catppuccin:macos",
];
---

<PageShell
	theme="home"
	title="Daniel Philipov"
	description="Daniel Philipov — CS & Physics student at UIUC. Projects, research, swimming, and more."
	kicker="Student, Researcher, Athlete"
	heading="Daniel Philipov"
	hero
>
	<section class="profile-grid" aria-label="Profile layout">
		<div class="photo-frame">
			<Image
				src={photo}
				alt="Daniel Philipov"
				class="profile-photo"
				loading="eager"
				fetchpriority="high"
			/>
		</div>
		<article class="bio-box">
			<h3>About Me</h3>
			<p>
				Hi, my name is Daniel Philipov! I am a Junior at UIUC studying
				Computer Science and Physics, and minoring in Astronomy.
			</p>
			<p>
				My hobbies include coding, competitive swimming, skiing,
				soccer, and playing video games with my friends and family.
			</p>
			<p>
				When it comes to coding, I'm driven by the beauty of code. I
				strive to achieve neatness, simplicity, and performance in
				everything I make, whether it be an AI algorithm, platformer
				game, or even this website.
			</p>
			<p>
				You can find me this summer at Google Sunnyvale, working on
				overhauling the Google Drive spam detection engine.
			</p>
			<h3>My Tech Stack</h3>
			<div class="tech-stack">
				{
					tech_stack.map((icon_name) => (
						<Icon
							name={icon_name}
							height="20pt"
							width="23pt"
							title={icon_name.split(":")[1]}
						/>
					))
				}
			</div>
		</article>
	</section>
</PageShell>

<style>
	.profile-grid {
		display: grid;
		grid-template-columns: minmax(220px, 38%) minmax(260px, 1fr);
		gap: clamp(1rem, 2.2vw, 1.5rem);
		align-items: stretch;
	}

	.photo-frame {
		position: relative;
		min-height: clamp(300px, 44vh, 520px);
		border: 1px solid var(--hairline);
		border-radius: 8px;
		background: #090d16bd;
		box-shadow: inset 0 0 0 1px rgba(252, 252, 250, 0.12);
		overflow: hidden;
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		opacity: 0;
		animation: rise-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.25s forwards;
	}

	.photo-frame :global(picture) {
		position: absolute;
		inset: 0;
		display: block;
	}

	.photo-frame :global(img.profile-photo) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
		object-position: center center;
	}

	.bio-box {
		position: relative;
		border: 1px solid rgba(251, 113, 133, 0.32);
		border-radius: 8px;
		background: radial-gradient(
				120% 120% at 0% 0%,
				rgba(251, 113, 133, 0.18),
				transparent 55%
			),
			linear-gradient(
				180deg,
				rgba(21, 8, 12, 0.95),
				rgba(21, 8, 12, 0.87)
			);
		box-shadow: 0 10px 35px rgba(0, 0, 0, 0.25);
		overflow: hidden;
		font-size: clamp(1.03rem, 1.45vw, 1.16rem);
		line-height: 1.6;
		padding: clamp(1rem, 2vw, 1.35rem);
		opacity: 0;
		animation: rise-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards;
	}

	.bio-box::before {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		pointer-events: none;
		border: 1px solid rgba(255, 255, 255, 0.12);
		mask: linear-gradient(#000, transparent 30%);
	}

	.bio-box::after {
		content: "+";
		position: absolute;
		top: 0.4rem;
		right: 0.6rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		line-height: 1;
		color: #fda4af;
		opacity: 0.4;
		pointer-events: none;
	}

	.bio-box h3 {
		margin: 0 0 0.75rem;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #fda4af;
	}

	.bio-box h3::before {
		content: "//";
		margin-right: 0.5rem;
		opacity: 0.55;
	}

	.bio-box p {
		margin: 0 0 0.9rem;
		color: #e7dbe1;
	}

	.bio-box p:last-of-type {
		margin-bottom: 1.1rem;
	}

	.tech-stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 0.5rem;
		align-items: center;
	}

	.tech-stack :global(svg) {
		transition: transform 160ms ease;
	}

	.tech-stack :global(svg:hover) {
		transform: translateY(-3px) scale(1.12);
	}

	@media (max-width: 840px) {
		.profile-grid {
			grid-template-columns: 1fr;
		}

		.photo-frame {
			min-height: clamp(240px, 40vh, 340px);
		}
	}
</style>
