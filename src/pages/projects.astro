---
import PageShell from "@/layouts/PageShell.astro";
import Project from "@/components/project.astro";

import { projects } from "@/data/projects.ts";
---

<PageShell
  theme="projects"
  title="Daniel's Projects"
  description="Selected builds, hackathon wins, and experiments by Daniel Philipov."
  kicker="Selected builds, research, and experiments"
  heading="Projects"
>
  <section class="project-grid" aria-label="Projects">
    {projects.map((project, index) => <Project {...project} index={index} />)}
  </section>
</PageShell>

<style>
  /*
   * Native CSS masonry via grid lanes: items pack vertically into the
   * column with the most room instead of aligning to a shared row
   * baseline. `display: grid` is the fallback — browsers that don't
   * recognize `grid-lanes` keep it and render a regular equal-row grid.
   * Ships unflagged in Safari 26.4; behind a flag elsewhere for now.
   */
  .project-grid {
    display: grid;
    display: grid-lanes;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
    padding-bottom: 3rem;
  }

  .project-grid :global(.info-card) {
    transition: transform 0.2s ease;
  }

  .project-grid :global(.info-card:hover) {
    transform: translateY(-4px);
  }

  @media (max-width: 1000px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px), (orientation: portrait) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
