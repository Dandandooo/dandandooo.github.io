---
import PageShell from "@/layouts/PageShell.astro";
import Project from "@/components/project.astro";

import { projects } from "@/data/projects.ts";
---

<PageShell
  theme="projects"
  title="Daniel's Projects"
  description="Selected builds, hackathon wins, and experiments by Daniel Philipov."
  kicker="Selected builds, research, and experiments"
  heading="Projects"
>
  <section class="project-grid" aria-label="Projects">
    {projects.map((project, index) => <Project {...project} index={index} />)}
  </section>
</PageShell>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
    padding-bottom: 3rem;
  }

  .project-grid :global(.info-card) {
    grid-column: span 4;
  }

  .project-grid :global(.info-card:nth-child(3n + 1)) {
    transform: translateY(0.4rem) rotate(-0.35deg);
  }

  .project-grid :global(.info-card:nth-child(3n + 2)) {
    transform: translateY(0.95rem) rotate(0.3deg);
  }

  .project-grid :global(.info-card:nth-child(3n)) {
    transform: translateY(0.8rem) rotate(-0.25deg);
  }

  .project-grid :global(.info-card:hover) {
    transform: translateY(-4px) rotate(-0.2deg);
  }

  @media (max-width: 1000px) {
    .project-grid :global(.info-card) {
      grid-column: span 6;
    }

    .project-grid :global(.info-card:nth-child(odd)) {
      transform: translateY(0.4rem);
    }

    .project-grid :global(.info-card:nth-child(even)) {
      transform: translateY(0);
    }
  }

  @media (max-width: 640px), (orientation: portrait) {
    .project-grid {
      grid-template-columns: 1fr;
    }

    .project-grid :global(.info-card),
    .project-grid :global(.info-card:hover) {
      grid-column: auto;
      transform: none !important;
    }
  }
</style>
