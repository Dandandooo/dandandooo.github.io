---
import PageShell from "@/layouts/PageShell.astro";
import PhotoTile from "@/components/PhotoTile.astro";

type PhotoTileData = {
  title: string;
  size: "full" | "large" | "wide" | "tall" | "standard";
  image?: ImageMetadata;
  location?: string;
  description?: string;
};

import snowbird from "@/assets/images/snowbird_view.jpeg";

const photoTiles: PhotoTileData[] = [
  {
    title: "Portfolio Feature Strip",
    size: "full",
    // image: null
  },
  {
    title: "Golden Hour Street",
    size: "full",
    image: snowbird,
    location: "Snowbird Mountain Resort, UT",
  },
  { title: "Lake Reflection", size: "wide" },
  { title: "City Silhouette", size: "tall" },
  { title: "Morning Lines", size: "standard" },
  { title: "Trail in Fog", size: "wide" },
  { title: "Detail Study", size: "standard" },
  { title: "Pier at Dusk", size: "large" },
  { title: "Night Motion", size: "tall" },
];
---

<PageShell
  theme="photography"
  title="Daniel's Photography"
  description="Photography by Daniel Philipov — frames, light, and stories through the lens."
  kicker="Frames, light, and stories through the lens"
  heading="Photography"
>
  <section class="photo-grid" aria-label="Photography grid">
    {
      photoTiles.map((tile, index) => (
        <PhotoTile
          title={tile.title}
          size={tile.size}
          index={index + 1}
          image={tile.image}
          imageAlt={tile.title}
        />
      ))
    }
  </section>
</PageShell>

<style>
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: minmax(92px, auto);
    gap: 0.5rem;
    padding-bottom: 3rem;
  }

  @media (max-width: 980px) {
    .photo-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-auto-rows: minmax(88px, auto);
    }
  }

  @media (max-width: 640px) {
    .photo-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
      gap: 0.55rem;
    }
  }
</style>
