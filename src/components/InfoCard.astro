---
import { Icon } from "astro-icon/components";

const {
  title,
  description,
  href,
  tags = [],
  accent = "cyan",
  eyebrow = "Info Card",
  secondaryDate,
  award,
  icon,
  index = 0,
  clampLines,
  linkLabel = "View project",
  tagsLabel = "technologies",
} = Astro.props;

const normalizedSecondaryDate =
  typeof secondaryDate === "string" ? secondaryDate.trim() : secondaryDate;
const hasSecondaryDate = Boolean(normalizedSecondaryDate);
const normalizedAward = typeof award === "string" ? award.trim() : award;
const hasAward = Boolean(normalizedAward);
---

<article
  class="info-card"
  style={`--card-accent: ${accent}; --stagger: ${index};`}
>
  <div class="card-header">
    <div class="header-copy">
      <div class="eyebrow-wrap">
        <div class="eyebrow" tabindex={hasSecondaryDate ? 0 : undefined}>
          <span
            class={hasSecondaryDate
              ? "eyebrow-primary can-swap"
              : "eyebrow-primary"}
          >
            {eyebrow}
          </span>
          {
            hasSecondaryDate && (
              <span class="eyebrow-secondary" aria-hidden="true">
                {normalizedSecondaryDate}
              </span>
            )
          }
        </div>
      </div>
      <h2>{title}</h2>
    </div>
    {
      icon && (
        <span class="card-icon" aria-hidden="true">
          {icon.includes("/") ? (
            <img
              class="card-icon-image"
              src={icon}
              alt=""
              loading="lazy"
              decoding="async"
            />
          ) : (
            <Icon class="card-icon-image" name={icon} />
          )}
        </span>
      )
    }
  </div>
  {
    clampLines ? (
      <div class="desc-wrap">
        <p class="desc is-clamped" style={`--clamp-lines: ${clampLines}`}>
          {description}
        </p>
        <button class="clamp-toggle" type="button" aria-expanded="false">
          Read more +
        </button>
      </div>
    ) : (
      <p class="desc">{description}</p>
    )
  }
  <ul class="stack" aria-label={`${title} ${tagsLabel}`}>
    {
      tags.map((item: string | { label: string; href?: string }) => (
        <li>
          {typeof item !== "string" && item.href ? (
            <a
              class="tag-link"
              href={item.href}
              target="_blank"
              rel="noreferrer"
            >
              {item.label}
            </a>
          ) : typeof item === "string" ? (
            item
          ) : (
            item.label
          )}
        </li>
      ))
    }
  </ul>
  {
    (href || hasAward) && (
      <div class="card-footer">
        {href ? (
          <a class="card-link" href={href} target="_blank" rel="noreferrer">
            {linkLabel}
          </a>
        ) : (
          <span />
        )}
        {hasAward && (
          <div class="award-badge" aria-label={`Award: ${normalizedAward}`}>
            {normalizedAward}
          </div>
        )}
      </div>
    )
  }
</article>

<script>
  document.addEventListener("click", (event) => {
    const toggle = (event.target as HTMLElement | null)?.closest?.(
      ".clamp-toggle"
    );
    if (!(toggle instanceof HTMLButtonElement)) return;
    const desc = toggle.closest(".desc-wrap")?.querySelector(".desc");
    if (!desc) return;
    const expanded = desc.classList.toggle("is-expanded");
    toggle.textContent = expanded ? "Show less −" : "Read more +";
    toggle.setAttribute("aria-expanded", String(expanded));
  });
</script>

<style>
  .info-card {
    position: relative;
    display: grid;
    gap: 0.85rem;
    padding: 1.15rem;
    border-radius: 8px;
    border: 1px solid
      color-mix(in srgb, var(--card-accent) 38%, var(--hairline));
    background: radial-gradient(
        120% 120% at 0% 0%,
        color-mix(in srgb, var(--card-accent) 17%, transparent),
        transparent 55%
      ),
      linear-gradient(180deg, #0d1117f2, #0d1117de);
    transition: transform 140ms ease, border-color 140ms ease,
      box-shadow 200ms ease;

    will-change: transform;
    /* Old Safari fallback */
    transform: translateZ(0);

    /* Animation */
    opacity: 0;
    animation: fade-in-card 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--stagger, 0) * 50ms);
  }

  /* Plus-tick corner marker, graph-paper style */
  .info-card::after {
    content: "+";
    position: absolute;
    top: 0.35rem;
    right: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1;
    color: color-mix(in srgb, var(--card-accent) 70%, #f8fafc);
    opacity: 0.35;
    pointer-events: none;
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .info-card:hover::after {
    opacity: 0.85;
    transform: rotate(90deg);
  }

  @keyframes fade-in-card {
    0% {
      opacity: 0;
      scale: 0.95;
    }
    100% {
      opacity: 1;
      scale: 1;
    }
  }

  .info-card:hover {
    transform: translateY(-3px) rotate(-0.25deg);
    border-color: color-mix(in srgb, var(--card-accent) 78%, #fff5);
    box-shadow: 0 16px 36px -18px
      color-mix(in srgb, var(--card-accent) 55%, transparent);
  }

  .eyebrow {
    display: inline-flex;
    width: fit-content;
    position: relative;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.62rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--card-accent) 75%, #f8fafc);
    border: 1px solid var(--hairline-strong);
    border-radius: 4px;
    padding: 0.26rem 0.5rem;
    background: #ffffff0d;
  }

  .eyebrow-wrap {
    position: relative;
    width: fit-content;
  }

  .eyebrow-primary {
    display: inline-block;
    transition: opacity 200ms ease;
  }

  .eyebrow-secondary {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease;
    white-space: nowrap;
  }

  .eyebrow-wrap:hover .eyebrow-secondary,
  .eyebrow:focus-visible .eyebrow-secondary {
    opacity: 1;
  }

  .eyebrow-wrap:hover .eyebrow-primary.can-swap,
  .eyebrow:focus-visible .eyebrow-primary.can-swap {
    opacity: 0;
  }

  .eyebrow:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--card-accent) 70%, #fff);
    outline-offset: 2px;
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.7rem;
  }

  .header-copy {
    display: grid;
    gap: 0.55rem;
    min-width: 0;
  }

  .card-icon {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    opacity: 0.88;
    pointer-events: none;
    flex: 0 0 auto;
    margin-top: 0.35rem;
  }

  .card-icon-image {
    width: 100% !important;
    height: 100% !important;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 1px 2px #0000005c);
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    letter-spacing: 0.02em;
    font-size: clamp(1.06rem, 1vw + 0.78rem, 1.42rem);
    line-height: 1.2;
  }

  .desc {
    margin: 0;
    color: #e2e8f0;
    line-height: 1.55;
    font-size: 0.96rem;
  }

  .desc-wrap {
    display: grid;
    gap: 0.15rem;
  }

  .desc.is-clamped:not(.is-expanded) {
    display: -webkit-box;
    -webkit-line-clamp: var(--clamp-lines, 4);
    line-clamp: var(--clamp-lines, 4);
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .clamp-toggle {
    width: fit-content;
    margin: 0.25rem 0 0;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--card-accent) 80%, #f8fafc);
  }

  .clamp-toggle:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stack li {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.64rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.26rem 0.48rem;
    border: 1px solid var(--hairline);
    border-radius: 4px;
    color: #dbe6f5;
    background: #ffffff0d;
  }

  .tag-link {
    color: inherit;
    text-decoration: none;
    display: block;
    margin: -0.26rem -0.48rem;
    padding: 0.26rem 0.48rem;
    border-radius: 4px;
  }

  .stack li:has(.tag-link):hover {
    background: color-mix(in srgb, var(--card-accent) 15%, #ffffff0d);
    border-color: color-mix(in srgb, var(--card-accent) 78%, #fff5);
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.34rem;
    width: fit-content;
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #f8fafc;
    text-decoration: none;
    border-bottom: 1px solid
      color-mix(in srgb, var(--card-accent) 70%, #f8fafc66);
    padding-bottom: 0.12rem;
  }

  .card-link::after {
    content: "→";
    transition: transform 160ms ease;
  }

  .card-link:hover {
    border-bottom-color: color-mix(in srgb, var(--card-accent) 92%, #f8fafc);
  }

  .card-link:hover::after {
    transform: translateX(3px);
  }

  .card-footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.7rem;
    margin-top: 0.2rem;
  }

  .award-badge {
    margin-left: auto;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.64rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #f6d457;
    border: 1px solid #ffd84d66;
    border-radius: 4px;
    background: #ffd84d1a;
    padding: 0.2rem 0.45rem;
    white-space: nowrap;
  }

  .award-badge::before {
    content: "🏆";
    margin-right: 0.32rem;
    font-size: 0.9em;
  }

  @media (max-width: 640px) {
    .info-card {
      transition: border-color 140ms ease;
      will-change: auto;
    }

    .info-card:hover {
      transform: none;
      box-shadow: none;
    }
  }
</style>
